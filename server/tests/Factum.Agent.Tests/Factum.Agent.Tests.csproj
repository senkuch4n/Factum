<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Factum.Agent es SelfContained (single-file para el portátil); los tests no. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Factum.Agent/Factum.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- metadatos-dispositivo §13.1: salidas reales y sintéticas de la ficha técnica. -->
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- extraccion-logica-android §12.2: fixture compartido del `record` (Tatana → API); el mismo que usa el test
       de la API, para que el contrato no se desincronice. -->
  <ItemGroup>
    <None Include="../Fixtures/extraction-record.json" Link="Fixtures/extraction-record.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
