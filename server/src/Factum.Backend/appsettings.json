{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "factum"
  },
  "Jwt": {
    "Secret": "factum-dev-secret-change-in-production",
    "ExpiryHours": 2,
    "SessionMaxHours": 12
  },
  "Auth": {
    "Mode": "dev",
    "AllowDevOutsideDevelopment": false,
    "Local": {
      "PasswordMinLength": 10,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "BootstrapSuperadmins": [],
      "ResetSuperadmin": { "Dni": "", "TemporaryPassword": "" }
    },
    "External": {
      "BaseUrl": "",
      "LoginPath": "/auth/login",
      "TimeoutSeconds": 10,
      "Request": { "DniField": "dni", "UserField": "user", "PasswordField": "password" },
      "Response": { "NameField": "name", "SiglaField": "sigla" }
    }
  },
  "Integrations": {
    "Support": {
      "Enabled": false,
      "BaseUrl": "",
      "ServiceKey": "",
      "TimeoutSeconds": 10,
      "FrontendUrl": ""
    }
  },
  "Storage": {
    "DataDirectory": "./dev-data"
  },
  "Security": {
    "LoginRateLimit": { "PerIpPermitLimit": 10, "PerIpWindowSeconds": 60, "PerDniPermitLimit": 5, "PerDniWindowSeconds": 60 }
  },
  "Audit": {
    "AdminDnis": []
  },
  "Tatana": {
    "MinVersion": ""
  },
  "Recording": {
    "SessionMode": "optional_off",
    "SegmentMinutes": 30
  },
  "Branding": {
    "OrganizationName": "",
    "OrganizationLogo": "",
    "OrganizationIsotype": "",
    "ContactLines": [],
    "PrimaryColor": "",
    "AccentColor": ""
  },
  "Timestamping": {
    "Urls": "",
    "Enabled": true,
    "TimeoutSeconds": 10,
    "MaxAttempts": 12,
    "InlineBudgetSeconds": 10,
    "GenerationBudgetSeconds": 15,
    "InlineCooldownSeconds": 120,
    "PollSeconds": 30
  },
  "Report": {
    "TimeZone": "America/Argentina/Buenos_Aires",
    "DomicilioConstituido": "",
    "EncryptZip": true,
    "ClockSkewWarningSeconds": 60,
    "DefaultTexts": {
      "OperacionesRealizadas": "",
      "AseguramientoEvidencia": "",
      "NotasTecnicas": "",
      "Reserva": ""
    }
  }
}
