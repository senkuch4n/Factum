{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "factum"
  },
  "Jwt": {
    "Secret": "factum-dev-secret-change-in-production",
    "ExpiryHours": 8
  },
  "Auth": {
    "Mode": "dev",
    "AllowDevOutsideDevelopment": false,
    "Local": {
      "PasswordMinLength": 10,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "BootstrapSuperadmins": [],
      "ResetSuperadmin": { "Dni": "", "TemporaryPassword": "" }
    },
    "External": {
      "BaseUrl": "",
      "LoginPath": "/auth/login",
      "TimeoutSeconds": 10,
      "Request": { "DniField": "dni", "UserField": "user", "PasswordField": "password" },
      "Response": { "NameField": "name", "SiglaField": "sigla" }
    }
  },
  "Integrations": {
    "Support": {
      "Enabled": false,
      "BaseUrl": "",
      "ServiceKey": "",
      "TimeoutSeconds": 10,
      "FrontendUrl": ""
    }
  },
  "Storage": {
    "DataDirectory": "./dev-data"
  },
  "Audit": {
    "AdminDnis": []
  },
  "TatanaUpdates": {
    "GitLabApiBaseUrl": "https://gitlab.com/api/v4",
    "ProjectId": "",
    "ProjectRawBaseUrl": "",
    "PrivateToken": "",
    "PublicBaseUrl": "http://localhost:8080",
    "CacheMinutes": 5
  },
  "Branding": {
    "OrganizationName": "",
    "OrganizationLogo": "",
    "OrganizationIsotype": "",
    "ContactLines": [],
    "PrimaryColor": "",
    "AccentColor": ""
  },
  "Report": {
    "TimeZone": "America/Argentina/Buenos_Aires",
    "DomicilioConstituido": "",
    "EncryptZip": true,
    "DefaultTexts": {
      "OperacionesRealizadas": "",
      "AseguramientoEvidencia": "",
      "NotasTecnicas": "",
      "Reserva": ""
    }
  }
}
