{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Agent": {
    "Port": 8765,
    "Mock": false,
    "DataDirectory": "./agent-data",
    "VideoPostprocess": {
      "Enabled": true,
      "BlendMaxSourceSeconds": 0,
      "RifeMaxSourceSeconds": 120,
      "TimeoutFactor": 3.0,
      "TimeoutExtraSeconds": 120,
      "TimeoutMinSeconds": 300,
      "TimeoutMaxSeconds": 7200,
      "ProgressIntervalSeconds": 3
    },
    "Recording": {
      "StartTimeoutSeconds": 20,
      "RequireStartMarker": true,
      "StopTimeoutSeconds": 30,
      "SigtermAfterSeconds": 3,
      "StayAwake": true,
      "WindowMode": "no_window",
      "AudioPlayback": true,
      "ToleranceMinSeconds": 3,
      "TolerancePercent": 2
    },
    "Session": {
      "ScreenBytesPerMinute": 31457280,
      "CameraBytesPerMinute": 18874368,
      "MinSegmentMinutes": 5,
      "MaxSegmentMinutes": 120,
      "DiskCheckSeconds": 60,
      "WarnMinutesLeft": 60,
      "CutReserveMinutes": 2,
      "ResumeDelaySeconds": 3,
      "ScreenProbeSeconds": 30,
      "RotationRetrySeconds": 60,
      "RotationConfirmMilliseconds": 1500,
      "RotationStartAttempts": 3,
      "ShutdownBudgetSeconds": 20,
      "CameraWidth": 1280,
      "CameraHeight": 720,
      "CameraFps": 15,
      "CameraCrf": 26,
      "CameraStartTimeoutSeconds": 10,
      "CameraStallSeconds": 20,
      "CameraPreviewIdleSeconds": 120
    }
  }
}
