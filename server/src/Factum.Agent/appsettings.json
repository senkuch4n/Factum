{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Agent": {
    "Port": 8765,
    "Mock": false,
    "DataDirectory": "./agent-data",
    "VideoPostprocess": {
      "Enabled": true,
      "BlendMaxSourceSeconds": 0,
      "RifeMaxSourceSeconds": 120,
      "TimeoutFactor": 3.0,
      "TimeoutExtraSeconds": 120,
      "TimeoutMinSeconds": 300,
      "TimeoutMaxSeconds": 7200,
      "ProgressIntervalSeconds": 3
    },
    "Recording": {
      "StartTimeoutSeconds": 20,
      "RequireStartMarker": true,
      "StopTimeoutSeconds": 30,
      "SigtermAfterSeconds": 3,
      "StayAwake": true,
      "WindowMode": "no_window",
      "ToleranceMinSeconds": 3,
      "TolerancePercent": 2
    }
  }
}
