# Factum — configuración de esta instalación. La genera instalar.ps1; no compartir (tiene el secreto JWT).
COMPOSE_PROJECT_NAME=factum
FACTUM_VERSION=0.0.0
FACTUM_HOME=C:/Factum
# 128 caracteres hex aleatorios, propios de esta PC. instalar.ps1 lo genera; nunca el valor del repo.
FACTUM_JWT_SECRET=
# Sesión: el token dura N h y se renueva con actividad, hasta el tope de horas desde el login (guía sección 6).
FACTUM_JWT_EXPIRY_HOURS=2
FACTUM_SESION_TOPE_HORAS=12
# dev = cualquier DNI + cualquier contraseña (ver aviso de seguridad en la guía). external = proveedor HTTP.
# local = cuentas propias de Factum (DNI + contraseña; superadmin inicial en appsettings.Local.json, ver README).
FACTUM_AUTH_MODE=dev
# true = se permite FACTUM_AUTH_MODE=dev en esta instalación local aislada. Con dev en false, el backend no arranca.
FACTUM_AUTH_ALLOW_DEV=true
# Carpeta de backups (vacío = C:/Factum/backups) y cuántos backups conservar ahí.
FACTUM_BACKUP_DESTINO=
FACTUM_BACKUP_CONSERVAR=10
# Perfil de memoria: normal (sin límites; PCs de 8 GB o más) o poca (PCs de 4 GB: suma
# docker-compose.poca-ram.yml). Lo fija instalar.ps1 según la RAM; para cambiarlo, ver la guía, sección 2.1.
FACTUM_PERFIL_MEMORIA=normal
# Sellado de tiempo RFC 3161 de un tercero (README, "Sellado de tiempo"). Vacío = desactivado.
# Lista en orden de preferencia, separada por comas. Ejemplos probados con openssl ts -verify:
#   https://freetsa.org/tsr,http://timestamp.digicert.com
# Factum no afirma la validez legal de ninguna autoridad: elegila con asesoramiento jurídico.
# Si la autoridad pide usuario y clave: https://usuario:clave@host/ruta (no se muestran en logs).
FACTUM_SELLADO_URLS=
FACTUM_SELLADO_HABILITADO=true
FACTUM_SELLADO_TIMEOUT_SEGUNDOS=10
FACTUM_SELLADO_MAX_INTENTOS=12
# Umbral (segundos) del aviso por diferencia de reloj entre el celular y la PC del perito (y entre la PC y el
# servidor): por encima, la web avisa y el informe deja constancia. Entre 1 y 86400; default 60.
FACTUM_RELOJ_UMBRAL_SEGUNDOS=60
# Grabación en video de la recolección completa (paso 3), en tramos con hash y sello cada uno (README, "Grabación de
# la recolección"). Modo: disabled (no se ofrece) | optional_off (el perito la activa; default) | optional_on (viene
# activada y el perito la puede apagar) | required (obligatoria). Un valor inválido deja el default y un aviso en el log.
FACTUM_GRABACION_SESION_MODO=optional_off
# Duración de cada tramo, en minutos: entre 5 y 120 (default 30).
FACTUM_GRABACION_SESION_TRAMO_MINUTOS=30
