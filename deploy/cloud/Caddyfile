# Factum — proxy HTTPS de producción. Dominio: FACTUM_DOMINIO (.env del VPS). Sin access log a propósito:
# las descargas llevan ?token= en la URL (B10). Ver docs/despliegue-nube.md, sección 8.
#
# Un solo hostname ruteado por path (DT1):
#   /api/*, /health, /health/*  -> backend
#   /tatana/updates/*            -> canal de actualización de Tatana (estático, /srv/factum/tatana-updates)
#   /descargas/*                 -> archivos estáticos (instalador de Tatana para la nube)
#   el resto                     -> frontend
# /tatana/updates/ y /descargas/tatana/ los publica el workflow tatana-release.yml por SSH con el usuario
# tatana-pub (scripts/publicar-tatana-forzado.sh). La integridad no depende de este servidor: Tatana
# verifica la firma Ed25519 de tatana-update.json (SDD tatana-instalador-autoupdate D7, guía sección 19).
# Caddy saca el certificado de Let's Encrypt solo y redirige http -> https.
{
	email {$FACTUM_ACME_EMAIL}
}

(seguridad) {
	header {
		# Sin includeSubDomains ni preload: con un dominio provisorio de terceros no corresponde (DT15).
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# CSP efectiva mínima: frame-ancestors se ignora en Report-Only, por eso va acá.
		Content-Security-Policy "frame-ancestors 'none'"
		# CSP completa solo en Report-Only (D13): las violaciones se ven en la consola del navegador.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://localhost:8765 http://127.0.0.1:8765; media-src 'self' blob: http://localhost:8765 http://127.0.0.1:8765; font-src 'self' data:; connect-src 'self' http://localhost:8765 ws://localhost:8765 http://127.0.0.1:8765 ws://127.0.0.1:8765; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# La web usa la cámara y el micrófono del navegador (CameraRecordModal, WebcamCaptureModal).
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
		-Server
	}
}

{$FACTUM_DOMINIO} {
	import seguridad
	encode zstd gzip

	@backend path /api/* /health /health/*
	handle @backend {
		# Tope de defensa: generate/finish acepta hasta 256 MiB (Report:MaxGenerateUploadBytes).
		request_body {
			max_size 300MB
		}
		reverse_proxy backend:8080
	}

	# Canal de Tatana: los manifiestos sin caché (una versión nueva se ve enseguida); el exe y el
	# .blockmap tienen nombre con versión y no cambian nunca.
	handle_path /tatana/updates/* {
		root * /srv/tatana-updates
		@manifiestos path /latest.yml /tatana-update.json
		header @manifiestos Cache-Control "no-cache"
		file_server
	}

	handle_path /descargas/* {
		root * /srv/descargas
		file_server
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Redirección de un dominio anterior (cambio de dominio, guía sección 15). Ver caddy-sitios/LEEME.md.
import /etc/caddy/sitios/*.caddy
